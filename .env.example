# Variables para desarrollo local de Edge Functions.
# Copia este archivo a `supabase/.env` y rellena los valores.
#
# En producción NO se usa: Supabase inyecta estas variables automáticamente
# en cada Edge Function. Nunca subas `supabase/.env` al repositorio.
#
# La service role key salta RLS: trátala como la contraseña de la base.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
